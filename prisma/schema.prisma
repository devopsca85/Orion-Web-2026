// ─────────────────────────────────────────────────────────────────────────────
// Orion Solutions — Database Schema
// Provider : MySQL (PlanetScale / Railway / AWS RDS / Azure MySQL)
// ORM      : Prisma
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum SubmissionStatus {
  NEW
  REVIEWED
  RESPONDED
  CLOSED
  SPAM
}

enum ApplicationStatus {
  RECEIVED
  REVIEWING
  PHONE_SCREEN
  INTERVIEW
  OFFER
  REJECTED
  HIRED
  WITHDRAWN
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
}

// ─────────────────────────────────────────────────────────────────────────────
// TRANSACTIONAL — Contact, Newsletter, Careers
// ─────────────────────────────────────────────────────────────────────────────

/// Contact form submissions from the website
model ContactSubmission {
  id          String           @id @default(cuid())
  name        String           @db.VarChar(100)
  email       String           @db.VarChar(255)
  company     String?          @db.VarChar(100)
  phone       String?          @db.VarChar(30)
  service     String?          @db.VarChar(80)
  message     String           @db.Text
  ipAddress   String?          @db.VarChar(45)
  userAgent   String?          @db.VarChar(512)
  status      SubmissionStatus @default(NEW)
  /// Internal notes added by admin / sales team
  notes       String?          @db.Text
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("contact_submissions")
}

/// Newsletter subscribers (double opt-in)
model NewsletterSubscriber {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(255)
  name         String?   @db.VarChar(100)
  /// Set to true after email confirmation link is clicked
  confirmed    Boolean   @default(false)
  confirmedAt  DateTime?
  /// Token sent in the confirmation email
  confirmToken String?   @unique @db.VarChar(128)
  unsubscribed Boolean   @default(false)
  unsubAt      DateTime?
  /// Where on the site they signed up: "footer", "blog", "contact", "popup"
  source       String?   @db.VarChar(50)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([confirmed])
  @@map("newsletter_subscribers")
}

/// Job applications submitted via /careers
model JobApplication {
  id           String            @id @default(cuid())
  name         String            @db.VarChar(100)
  email        String            @db.VarChar(255)
  phone        String?           @db.VarChar(30)
  role         String            @db.VarChar(150)
  department   String?           @db.VarChar(100)
  /// Path or URL to the uploaded résumé (blob storage)
  resumeUrl    String?           @db.VarChar(512)
  coverLetter  String?           @db.Text
  linkedinUrl  String?           @db.VarChar(512)
  portfolioUrl String?           @db.VarChar(512)
  status       ApplicationStatus @default(RECEIVED)
  /// Internal recruiter notes
  notes        String?           @db.Text
  reviewedBy   String?           @db.VarChar(100)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("job_applications")
}

// ─────────────────────────────────────────────────────────────────────────────
// CMS CONTENT — replaces static lib/data/ files when DB is active
// Note: MySQL has no native array type — array fields use Json
// ─────────────────────────────────────────────────────────────────────────────

/// Service pages (replaces lib/data/services.ts)
model Service {
  slug            String   @id @db.VarChar(100)
  title           String   @db.VarChar(150)
  shortDesc       String   @db.VarChar(300)
  description     String   @db.Text
  icon            String   @db.VarChar(50)
  /// JSON array of strings: ["Feature 1", "Feature 2", ...]
  features        Json
  benefits        Json
  technologies    Json
  metaTitle       String?  @db.VarChar(70)
  metaDescription String?  @db.VarChar(160)
  published       Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published])
  @@map("services")
}

/// Portfolio / case studies (replaces lib/data/portfolio.ts)
model PortfolioItem {
  slug         String   @id @db.VarChar(100)
  title        String   @db.VarChar(200)
  client       String   @db.VarChar(150)
  industry     String   @db.VarChar(100)
  service      String   @db.VarChar(100)
  challenge    String   @db.Text
  solution     String   @db.Text
  outcome      String   @db.Text
  /// JSON array: [{ "label": "...", "value": "..." }]
  metrics      Json
  /// JSON array of technology name strings
  technologies Json
  imageUrl     String?  @db.VarChar(512)
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published])
  @@index([featured])
  @@map("portfolio_items")
}

/// Blog authors
model Author {
  id        String     @id @default(cuid())
  name      String     @db.VarChar(100)
  role      String     @db.VarChar(100)
  bio       String?    @db.Text
  avatarUrl String?    @db.VarChar(512)
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("authors")
}

/// Blog posts (replaces lib/data/blog.ts)
model BlogPost {
  slug        String     @id @db.VarChar(100)
  title       String     @db.VarChar(250)
  excerpt     String     @db.VarChar(500)
  content     String     @db.LongText
  category    String     @db.VarChar(80)
  /// JSON array of tag strings
  tags        Json
  authorId    String
  author      Author     @relation(fields: [authorId], references: [id])
  status      PostStatus @default(DRAFT)
  featured    Boolean    @default(false)
  publishedAt DateTime?
  readingTime Int        @default(5)
  imageUrl    String?    @db.VarChar(512)
  metaTitle   String?    @db.VarChar(70)
  metaDesc    String?    @db.VarChar(160)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([category])
  @@index([featured])
  @@map("blog_posts")
}

/// Leadership / team members (replaces lib/data/team.ts)
model TeamMember {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100)
  role      String   @db.VarChar(100)
  bio       String   @db.Text
  avatarUrl String?  @db.VarChar(512)
  linkedin  String?  @db.VarChar(512)
  isLeader  Boolean  @default(true)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isLeader, sortOrder])
  @@map("team_members")
}

model User {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(100)
  email       String    @unique @db.VarChar(255)
  password    String    @db.VarChar(255)
  role        Role      @default(AUTHOR)
  avatar      String?   @db.VarChar(512)
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@map("users")
}

model Resource {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(100)
  title       String   @db.VarChar(250)
  type        String   @db.VarChar(50)
  topic       String   @db.VarChar(80)
  excerpt     String   @db.VarChar(500)
  coverImage  String?  @db.VarChar(512)
  gated       Boolean  @default(true)
  watchUrl    String?  @db.VarChar(512)
  publishedAt DateTime @default(now())
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@map("resources")
}

/// Site-wide stats displayed on pages
model SiteStat {
  id        String   @id @default(cuid())
  label     String   @db.VarChar(80)
  value     String   @db.VarChar(20)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_stats")
}

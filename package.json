    "db:reset": "prisma migrate reset",
    "migrate:wp": "ts-node --project tsconfig.scripts.json scripts/migrate-from-wp.ts",
    "seed:services": "ts-node --project tsconfig.scripts.json scripts/seed-services.ts",

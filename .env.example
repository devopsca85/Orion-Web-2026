# ──────────────────────────────────────────────
# Database (MySQL)
# Recommended hosts: PlanetScale · Railway · AWS RDS · Azure Database for MySQL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl={"rejectUnauthorized":true}
# ──────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/orion_db?ssl={"rejectUnauthorized":true}

# Admin IP allowlist for /admin routes (comma-separated, leave blank to disable)
ADMIN_IP_ALLOWLIST=

# ──────────────────────────────────────────────
# NextAuth v5
# Generate with: openssl rand -base64 32
# ──────────────────────────────────────────────
AUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# ──────────────────────────────────────────────
# Site
# ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.orionesolutions.com
NEXT_PUBLIC_SITE_NAME="Orion eSolutions"

# ──────────────────────────────────────────────
# Email (Resend)  https://resend.com
# ──────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL=support@orionesolutions.com

# ──────────────────────────────────────────────
# Brevo (newsletter sync)  https://app.brevo.com
# ──────────────────────────────────────────────
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_LIST_ID=1

# ──────────────────────────────────────────────
# Google reCAPTCHA v3  https://www.google.com/recaptcha
# ──────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Le_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RECAPTCHA_SECRET_KEY=6Le_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────
# Sanity CMS  https://www.sanity.io
# ──────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_WEBHOOK_SECRET=

# ──────────────────────────────────────────────
# Analytics (optional)
# ──────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ──────────────────────────────────────────────
# WordPress Migration (npm run migrate:wp)
# WP_SITE_URL      = your WordPress site URL
# WP_USERNAME      = WP username (only needed for private/draft content)
# WP_APP_PASSWORD  = WP Application Password — generate at:
#                    WP Admin → Users → Profile → Application Passwords
# Leave WP_USERNAME and WP_APP_PASSWORD blank for public sites
# ──────────────────────────────────────────────
WP_SITE_URL=https://orionesolutions.com
WP_USERNAME=
WP_APP_PASSWORD=
